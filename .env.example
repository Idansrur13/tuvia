# --- Database (required) -------------------------------------------------
# Postgres connection used by Prisma. Any Postgres works (local, Supabase, Neon).
# Pooled connection used by the app at runtime:
DATABASE_URL="postgresql://user:password@localhost:5432/nadlan?schema=public"
# Direct connection used by `prisma migrate` (same value for a local database):
DIRECT_URL="postgresql://user:password@localhost:5432/nadlan?schema=public"

# --- AI features (optional) ----------------------------------------------
# Without a key the AI assistant answers with the built-in offline matching
# engine, and the smart import falls back to local CSV/JSON parsing.
# ANTHROPIC_API_KEY="sk-ant-..."
